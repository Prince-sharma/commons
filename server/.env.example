# Postgres (Neon, Supabase, or any Postgres 14+)
DATABASE_URL=postgres://user:pass@host/db
# Long random string: signs dashboard sessions
SESSION_SECRET=
# Password for /setup, where you create organizations
SUPERADMIN_PASSWORD=
# Sent by Vercel Cron to /api/cron/daily
CRON_SECRET=
# Sarvam API key for labelling sessions (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# Optional
# SARVAM_MODEL=sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# COMMONS_URL=https://commons.example.com   (shown in Settings; defaults to the request host)
# COMMONS_PLUGIN_REPO=your-org/commons      (shown in Settings; defaults to Prince-sharma/commons)
